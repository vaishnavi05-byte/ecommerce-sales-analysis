table Orders

	measure 'Delivered Orders' = COUNTROWS(Orders)
		formatString: #,0

	measure 'Merchandise Sales' = DIVIDE(SUM(Orders[merchandise_cents]),100)
		formatString: #,0.00

	measure 'Items' = SUM(Orders[item_count])
		formatString: #,0

	measure 'Average Order Value' = DIVIDE([Merchandise Sales],[Delivered Orders])
		formatString: 0.00

	measure 'Eligible Deliveries' = SUM(Orders[delivery_eligible])
		formatString: #,0

	measure 'Late Orders' = SUM(Orders[late_order])
		formatString: #,0

	measure 'On Time Orders' = [Eligible Deliveries]-[Late Orders]
		formatString: #,0

	measure 'Late Rate' = DIVIDE([Late Orders],[Eligible Deliveries])
		formatString: 0.0%

	measure 'Average Delivery Days' = DIVIDE(SUM(Orders[eligible_delivery_seconds]),[Eligible Deliveries]*86400)
		formatString: 0.00

	measure 'Missing Actual Dates' = [Delivered Orders]-[Eligible Deliveries]
		formatString: #,0

	measure 'Items Per Order' = DIVIDE([Items],[Delivered Orders])
		formatString: 0.00

	measure 'Selected Metric' = SWITCH(SELECTEDVALUE(Metric[Label],"Merchandise sales"),"Delivered orders",[Delivered Orders],"Late orders",[Late Orders],[Merchandise Sales])
		formatString: #,0

	measure 'Target Late Rate' = DIVIDE(SELECTEDVALUE(Target[Percent],5),100)
		formatString: 0.0%

	measure 'Late Rate Gap' = [Late Rate]-[Target Late Rate]
		formatString: +0.0%;-0.0%;0.0%

	measure 'Orders Above Target' = MAX(0,[Late Orders]-[Eligible Deliveries]*[Target Late Rate])
		formatString: #,0

	measure 'State Sales Share' = DIVIDE([Merchandise Sales],CALCULATE([Merchandise Sales],REMOVEFILTERS(Orders[customer_state])))
		formatString: 0.0%

	measure 'Sample Qualified Late Rate' = IF([Eligible Deliveries]>=SELECTEDVALUE(MinimumSample[Orders],100),[Late Rate])
		formatString: 0.0%

	measure 'Selected States' = DISTINCTCOUNT(Orders[customer_state])
		formatString: #,0

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column purchase_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: purchase_date

	column purchase_year
		dataType: int64
		summarizeBy: none
		sourceColumn: purchase_year

	column purchase_month
		dataType: string
		summarizeBy: none
		sourceColumn: purchase_month

	column customer_state
		dataType: string
		summarizeBy: none
		sourceColumn: customer_state

	column item_count
		dataType: int64
		summarizeBy: none
		sourceColumn: item_count

	column merchandise_cents
		dataType: int64
		summarizeBy: none
		sourceColumn: merchandise_cents

	column delivery_eligible
		dataType: int64
		summarizeBy: none
		sourceColumn: delivery_eligible

	column late_order
		dataType: int64
		summarizeBy: none
		sourceColumn: late_order

	column eligible_delivery_seconds
		dataType: int64
		summarizeBy: none
		sourceColumn: eligible_delivery_seconds

	column delivery_outcome
		dataType: string
		summarizeBy: none
		sourceColumn: delivery_outcome

	column basket_band
		dataType: string
		summarizeBy: none
		sourceColumn: basket_band

	partition Orders = m
		mode: import
		source = let Raw=Csv.Document(File.Contents(DataFolder & "/Orders.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]), Headers=Table.PromoteHeaders(Raw,[PromoteAllScalars=true]), Typed=Table.TransformColumnTypes(Headers,{{"order_id",type text},{"purchase_date",type date},{"purchase_year",Int64.Type},{"purchase_month",type text},{"customer_state",type text},{"item_count",Int64.Type},{"merchandise_cents",Int64.Type},{"delivery_eligible",Int64.Type},{"late_order",Int64.Type},{"eligible_delivery_seconds",Int64.Type},{"delivery_outcome",type text},{"basket_band",type text}},"en-US") in Typed
